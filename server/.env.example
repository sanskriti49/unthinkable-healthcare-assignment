# =============================================================================
# Healthcare Appointment & Follow-up Manager — server configuration
# =============================================================================
#
# Copy this file to `server/.env` and fill it in:
#
#     cp server/.env.example server/.env
#
# Only DATABASE_URL and JWT_SECRET are REQUIRED. Every third-party integration
# below is OPTIONAL: leave it blank and that feature degrades to a documented
# fallback instead of breaking. You can add keys later without touching code
# or migrating anything — restart the server and the feature switches on.
#
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# Postgres connection string.
#   Local Docker (see docker-compose.yml):
DATABASE_URL="postgresql://healthcare:healthcare@localhost:5432/healthcare?schema=public"
#   Hosted (Render/Railway/Neon/Supabase) usually needs SSL:
# DATABASE_URL="postgresql://user:pass@host:5432/db?schema=public&sslmode=require"

# Secret used to sign session tokens. MUST be changed for any real deployment.
# Generate one with:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

NODE_ENV="development"
PORT=4000

# Public URL of the frontend. Used in email links and as the OAuth return target.
APP_URL="http://localhost:5173"
# Public URL of this API.
API_URL="http://localhost:4000"

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS="http://localhost:5173"

# IANA timezone the clinic operates in. Working hours are expressed in this
# zone; all instants are stored in UTC.
CLINIC_TIMEZONE="Asia/Kolkata"

LOG_LEVEL="info"


# -----------------------------------------------------------------------------
# Booking rules
# -----------------------------------------------------------------------------

# How long a slot stays reserved while the patient fills in their symptoms.
SLOT_HOLD_TTL_MINUTES=10

# Minimum notice required before an appointment starts.
BOOKING_MIN_LEAD_MINUTES=30

# How far ahead of the appointment the reminder email is sent.
APPOINTMENT_REMINDER_LEAD_HOURS=24


# =============================================================================
#  >>>  PUT YOUR API KEY HERE  <<<
# =============================================================================
#
# ANTHROPIC / CLAUDE — powers the two AI features:
#   1. Pre-visit symptom summary (urgency, chief complaint, 3 questions)
#   2. Post-visit patient summary + medication schedule extraction
#
# LEAVE IT BLANK AND EVERYTHING STILL WORKS. With no key the system uses
# deterministic fallbacks: a keyword-based triage screen and a rule-based
# prescription parser. Output is clearly labelled "AI unavailable" in the UI so
# nobody mistakes a fallback for a model summary. Bookings, reminders, emails
# and reminders are entirely unaffected.
#
# Get a key at https://console.anthropic.com/settings/keys
#
ANTHROPIC_API_KEY=""

# Model to use. Defaults to Claude Opus 5.
LLM_MODEL="claude-opus-5"
LLM_MAX_TOKENS=1400
LLM_TIMEOUT_MS=25000
# Attempts per generation before falling back to the deterministic path.
LLM_MAX_ATTEMPTS=3
# Only change this if you route through a proxy or gateway.
# ANTHROPIC_BASE_URL="https://api.anthropic.com"


# -----------------------------------------------------------------------------
# EMAIL  (optional)
# -----------------------------------------------------------------------------
#
# Leave SMTP_HOST blank and every email is rendered and written to disk as an
# .eml file in EMAIL_OUTBOX_DIR instead of being delivered. The full
# notification pipeline — queueing, retries, backoff, dead-lettering — runs
# exactly as it would in production, so the flow is demoable with no account.
#
# Set SMTP_HOST to switch to real delivery. Works with any SMTP provider.

EMAIL_FROM="Clinic Reception <no-reply@clinic.local>"
EMAIL_OUTBOX_DIR=".mailbox"

# --- SendGrid ---
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT=587
# SMTP_USER="apikey"
# SMTP_PASS="SG.your-sendgrid-api-key"

# --- Mailgun ---
# SMTP_HOST="smtp.mailgun.org"
# SMTP_PORT=587
# SMTP_USER="postmaster@your-domain.mailgun.org"
# SMTP_PASS="your-mailgun-password"

# --- Gmail (needs an App Password, not your account password) ---
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your-16-char-app-password"

# SMTP_SECURE=false   # true only for port 465


# -----------------------------------------------------------------------------
# GOOGLE CALENDAR  (optional)
# -----------------------------------------------------------------------------
#
# Leave blank and calendar sync is skipped — appointments are marked
# NOT_CONFIGURED and everything else works normally.
#
# To enable (full walkthrough in docs/GOOGLE_CALENDAR.md):
#   1. Create a project at https://console.cloud.google.com
#   2. Enable the Google Calendar API
#   3. Configure the OAuth consent screen, scope
#      https://www.googleapis.com/auth/calendar.events
#   4. Create an OAuth 2.0 Client ID of type "Web application"
#   5. Add the redirect URI below to that client's authorised redirect URIs —
#      it must match EXACTLY, including scheme, port and path.

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/calendar/google/callback"


# -----------------------------------------------------------------------------
# Background worker
# -----------------------------------------------------------------------------

# true  — run the job worker inside the API process (simplest; one service)
# false — run it separately with `npm run worker` (scale independently)
RUN_WORKER_INLINE=true

WORKER_POLL_INTERVAL_MS=3000
WORKER_BATCH_SIZE=5

# Retry backoff: delay = base * 2^(attempt-1), with jitter, capped at max.
JOB_BACKOFF_BASE_SECONDS=30
JOB_BACKOFF_MAX_SECONDS=3600


# -----------------------------------------------------------------------------
# Seed data
# -----------------------------------------------------------------------------

# Password given to every demo account created by `npm run db:seed`.
SEED_PASSWORD="Password123!"
