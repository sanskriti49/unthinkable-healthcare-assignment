{
  "name": "healthcare-appointment-manager",
  "private": true,
  "version": "1.0.0",
  "description": "Healthcare Appointment & Follow-up Manager - patient, doctor and admin portals with LLM-assisted triage and follow-up",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:worker": "npm run worker --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "test": "npm run test --workspace=server",
    "setup": "npm install && npm run db:migrate && npm run db:seed"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
